# Copy to .env and fill in. Never commit .env.

# Public addresses served by Caddy.
# Locally: http://app.localhost and http://sites.localhost.
# On the VPS: real hostnames with no scheme, so Caddy gets HTTPS automatically.
# Without a domain, sslip.io works: app.203.0.113.10.sslip.io / sites.203.0.113.10.sslip.io
APP_ADDRESS=http://app.localhost
SITES_ADDRESS=http://sites.localhost
# Folder the site workflows copy builds into (on the VPS: /srv/sites)
SITES_DIR=./data/sites

POSTGRES_USER=change_agents
POSTGRES_PASSWORD=change_agents
POSTGRES_DB=change_agents

# LLM providers: only the ones you use need a key.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Each model is "provider:model". Switch providers by changing these lines.
# Gemini's free tier gives each model its own daily quota: Flash Lite models 500 per day, Flash 20.
INTAKE_MODEL=google_genai:gemini-3.5-flash-lite
CODER_MODEL=google_genai:gemini-3.5-flash-lite
REVIEWER_MODEL=google_genai:gemini-3.1-flash-lite
INDEXER_MODEL=google_genai:gemini-3.5-flash-lite
# Changing the embedding model or dimension requires re-indexing every site.
EMBEDDING_MODEL=google_genai:gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# Free tier: each text in a batch counts as one request (limit 100 per minute).
EMBEDDING_TEXTS_PER_MINUTE=90

# GitHub access for the agents: a fine-grained token scoped to the test-site repos only.
GITHUB_ORG=
GITHUB_TOKEN=

# Shared secret the site workflows use to sign deploy webhooks (used from Phase 7).
DEPLOY_WEBHOOK_SECRET=

# Requests per minute per model. Gemini's free tier (Oct 2026): Flash Lite 15, Flash 5.
LLM_REQUESTS_PER_MINUTE=12
# Per-model exceptions, as JSON, e.g. {"google_genai:gemini-3.8-flash": 4}
# LLM_RPM_OVERRIDES=

# Folder with one checkout per client site (used by the agents until they clone from GitHub).
SITES_REPOS_DIR=./test-sites

# Bull Board (queue dashboard) at /api/queues, user "agency". Leave empty to turn it off.
BULL_BOARD_PASSWORD=
# Until Phase 6: share (0 to 1) of stub review jobs that fail on purpose, to see retries.
STUB_FAILURE_RATE=0
