# Edge proxy for everything on the server.
# Locally the addresses are http://*.localhost. On a server with its own ports 80/443 they are real
# hostnames and Caddy gets HTTPS certificates for them. Behind a tunnel (docker-compose.tunnel.yml)
# they are local ports, and the tunnel does HTTPS.

{$APP_ADDRESS} {
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy panel:80
	}
}

# Client test sites, published here by the delivery jobs from each site's GitHub Actions build:
#   /<site-id>/                      production
#   /previews/<site-id>/pr-<number>/ preview of a pull request
{$SITES_ADDRESS} {
	root * /srv/sites
	file_server
}
